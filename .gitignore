# --- Compilación de LaTeX (todo esto se regenera) ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# --- Salida generada: se construye en CI, nunca se commitea ---
# (los PDFs que sí se publican viven en docs/pdf/, copiados a mano por ahora)
tex/**/*.pdf
/build/
# Huellas de build.py y sus wrappers de usar y tirar
.build-manifest.json
tex/_build_*

# Excepción: PDF ORIGINALES, sin fuente en el repo (Affinity, escaneos).
# No se pueden regenerar, así que se versionan. Ver tex/quaderns/README.md.
# Cuidado: no compiles dentro de estas carpetas o versionarás la salida.
!tex/quaderns/**/*.pdf
!tex/privat/**/*.pdf

# --- Ajustes locales de Claude Code (personales, no del proyecto) ---
.claude/settings.local.json

# --- Sistema y editores ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.swp
*~
